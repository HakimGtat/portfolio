---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}
const { project, index } = Astro.props;
const { title, summary, stack, results, demo } = project.data;
const preview = demo?.type === 'image' ? demo.src : demo?.poster;
---

<a class="card" href={`/notebook/projects/${project.id}/`}>
  <span class="trace" aria-hidden="true"><span class="packet"></span></span>
  <div class="card-top">
    <span class="idx">{String(index + 1).padStart(2, '0')}</span>
    <span class="arrow" aria-hidden="true">→</span>
  </div>
  {preview && <img class="preview" src={preview} alt="" loading="lazy" />}
  <h3>{title}</h3>
  <p class="summary">{summary}</p>
  {results[0] && <p class="result">{results[0]}</p>}
  <div class="tags">{stack.slice(0, 4).map((t) => <Tag name={t} />)}</div>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.4rem 1.4rem 1.3rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    overflow: hidden;
  }
  .card:hover {
    border-color: var(--teal);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    color: var(--ink);
  }

  /* The trace + packet: a dot runs along the card's top edge on hover. */
  .trace {
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg, var(--teal) 0 0) no-repeat 0 0 / 0% 100%;
    transition: background-size 0.5s ease;
  }
  .card:hover .trace {
    background-size: 100% 100%;
  }
  .packet {
    position: absolute;
    top: -3px;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--purple);
    opacity: 0;
  }
  .card:hover .packet {
    animation: packet 1.1s ease-in-out forwards;
  }
  @keyframes packet {
    0% {
      left: 0;
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      left: calc(100% - 8px);
      opacity: 0;
    }
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-faint);
    margin-bottom: 0.9rem;
  }
  .arrow {
    transition: transform 0.2s, color 0.2s;
  }
  .card:hover .arrow {
    transform: translateX(4px);
    color: var(--teal);
  }
  .preview {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 1rem;
    border: 1px solid var(--rule);
  }
  h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }
  .summary {
    color: var(--ink-soft);
    font-size: 0.95rem;
    flex: 1;
  }
  .result {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--purple);
    margin-bottom: 0.9rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .packet {
      display: none;
    }
  }
</style>
