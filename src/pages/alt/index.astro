---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import AltLayout from '../../alt/AltLayout.astro';
import Machine from '../../alt/Machine.astro';
import Icon from '../../alt/Icon.astro';
import { site } from '../../data/site';

const live = (
  await getCollection('projects', (p) => import.meta.env.DEV || p.data.status === 'live')
).sort((a, b) => a.data.order - b.data.order);

type Colour = 'grape' | 'teal' | 'tangerine' | 'sun';
interface Project {
  title: string;
  summary: string;
  automates: string;
  tags: string[];
  colour: Colour;
  href?: string;
  result?: string;
}

const projects: Project[] = [
  ...live.map((p) => ({
    title: p.data.title,
    summary: p.data.summary,
    automates: 'Code explanations: drafted by AI, checked by the build',
    tags: p.data.stack.slice(0, 4),
    colour: 'grape' as Colour,
    href: `/alt/projects/${p.id}/`,
  })),
  // Resume projects still being written up. Facts only, from the resume.
  {
    title: 'Markov prefetcher',
    summary: 'Predicts the next memory address a program needs and loads it into cache before it is asked for.',
    automates: 'Guessing what the CPU needs next',
    tags: ['C++', 'Linux', 'MacSim'],
    colour: 'teal',
    result: '−30% average memory access time',
  },
  {
    title: 'LiDAR room scanner',
    summary: 'A microcontroller turns a distance sensor through 360° and maps the room from the readings.',
    automates: 'Measuring a room by hand',
    tags: ['Embedded C', 'MSP432', 'Matplotlib'],
    colour: 'tangerine',
  },
  {
    title: 'Breezy smart fan',
    summary: 'A fan that finds people with an on-device vision model and aims itself at them. I built the motor control.',
    automates: 'Pointing a fan at whoever is in the room',
    tags: ['Python', 'Raspberry Pi', 'TensorFlow Lite'],
    colour: 'sun',
    result: 'Tracks people at 25 FPS',
  },
  {
    title: 'Network servers',
    summary: 'Client and server programs that talk over TCP and UDP, on both IPv4 and IPv6.',
    automates: 'Moving data between machines reliably',
    tags: ['Python', 'TCP/UDP', 'Sockets'],
    colour: 'teal',
  },
  {
    title: 'Image decompressor',
    summary: 'Hardware that rebuilds a compressed image step by step, written as finite state machines.',
    automates: 'Turning compressed data back into pixels',
    tags: ['SystemVerilog', 'FSMs', 'VGA'],
    colour: 'grape',
  },
];

const career = [
  {
    when: '2025 – 2026',
    role: 'Warehouse Supervisor',
    org: 'Pepsi',
    place: 'Mississauga',
    colour: 'tangerine' as Colour,
    points: [
      'Helped roll out SAP and Microsoft Azure at my site, cutting processing time for orders, deliveries and invoicing by 40%.',
      'Built Excel and Power BI dashboards for productivity, breakage and on-time shipping that management reported from.',
      'Supervised about 100 people and ran the daily scrum to keep weekly shipping quotas on track.',
    ],
    tags: ['SAP', 'Azure', 'Power BI', 'Excel'],
  },
  {
    when: 'Dec 2024',
    role: 'B.Eng. Computer Engineering',
    org: 'McMaster University',
    place: 'Hamilton',
    colour: 'grape' as Colour,
    points: ['Embedded systems, computer architecture, networking and hardware design projects.'],
    tags: ['C', 'C++', 'Python', 'SystemVerilog'],
  },
  {
    when: '2022 – 2023',
    role: 'Reliability Engineer Intern',
    org: 'Thermo Fisher Scientific',
    place: 'Mississauga',
    colour: 'teal' as Colour,
    points: [
      'Automated recurring data pulls with Python and showed the failure patterns to management, which led to schedule changes that cut unplanned downtime by 20%.',
      'Wrote SQL against the IBM Maximo asset database and built a Power BI pipeline that made company-wide KPI reporting 80% faster.',
      'Led root cause investigations on equipment failures at a GMP-regulated plant.',
    ],
    tags: ['Python', 'SQL', 'Power BI', 'IBM Maximo'],
  },
  {
    when: '2022',
    role: 'CNC Machine Operator',
    org: 'Pryor Metals',
    place: 'Ottawa',
    colour: 'sun' as Colour,
    points: ['Read engineering drawings and GD&T tolerances to keep a CNC turret punch press in spec.'],
    tags: [],
  },
];

const hasResume = existsSync(join(process.cwd(), 'public', site.resumePath));
const nav = [
  { id: 'projects', label: 'Projects' },
  { id: 'about', label: 'About' },
  { id: 'career', label: 'Career path' },
];
---

<AltLayout>
  <div class="page">
    <header class="side">
      <div class="side-top">
        <p class="hello"><span class="wave" aria-hidden="true"></span> Hi, I'm {site.name}</p>
        <h1 class="headline">I automate the boring parts.</h1>
        <p class="pitch">
          Computer engineer in Ottawa. I build tools that clean up data, sort out tasks and run hardware, so
          people can spend their time on the interesting work.
        </p>
        <p class="roles">
          <span class="pill pill-teal">Data analysis</span>
          <span class="pill pill-tangerine">IT support</span>
          <span class="pill pill-grape">Automation</span>
          <span class="pill pill-sun">Embedded &amp; systems</span>
        </p>

        <nav class="toc" aria-label="Sections">
          <ul role="list">
            {
              nav.map((n) => (
                <li>
                  <a href={`#${n.id}`} data-toc={n.id}>
                    <span class="toc-bar" aria-hidden="true" />
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="side-bottom">
        <a class="btn btn-primary" href={`mailto:${site.email}`}>
          Say hello <Icon name="arrow-right" class="icon-nudge" />
        </a>
        <div class="socials">
          <a class="social" href={site.github} aria-label="GitHub"><Icon name="github" /></a>
          <a class="social" href={site.linkedin} aria-label="LinkedIn"><Icon name="linkedin" /></a>
          {hasResume && <a class="social" href={site.resumePath} download aria-label="Download resume"><Icon name="download" /></a>}
          <button type="button" class="social" aria-label="Switch light or dark theme" data-theme-toggle>
            <Icon name="sun" class="sun" />
            <Icon name="moon" class="moon" />
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="content">
      <Machine />

      <section id="projects" class="section" aria-labelledby="projects-title">
        <h2 id="projects-title" class="section-title">Projects</h2>
        <ul class="cards" role="list">
          {
            projects.map((p) => {
              const Tag = p.href ? 'a' : 'article';
              return (
                <li>
                  <Tag class:list={['card', `c-${p.colour}`, { 'is-link': p.href }]} href={p.href}>
                    <span class="card-dot" aria-hidden="true" />
                    <div class="card-body">
                      <h3 class="card-title">
                        {p.title}
                        {p.href && <Icon name="arrow-right" class="card-arrow" />}
                      </h3>
                      <p class="card-automates">Automates: {p.automates}</p>
                      <p class="card-sum">{p.summary}</p>
                      {p.result && <p class="card-result">{p.result}</p>}
                      <p class="card-tags">
                        {p.tags.map((t) => (
                          <span class="pill">{t}</span>
                        ))}
                        <span class:list={['card-status', { live: p.href }]}>
                          {p.href ? 'Full write-up and code' : 'Write-up coming soon'}
                        </span>
                      </p>
                    </div>
                  </Tag>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section id="about" class="section" aria-labelledby="about-title">
        <h2 id="about-title" class="section-title">About</h2>
        <div class="about">
          <p>
            I studied computer engineering at McMaster, and I've worked on a plant floor, in a warehouse and in
            code. The common thread is that I can't leave a repetitive job alone: if something is done by hand
            every week, I want to script it, dashboard it or build a machine for it.
          </p>
          <p>
            That's taken me from Python scripts that pull maintenance data, to Power BI reports managers
            actually use, to microcontrollers that measure a room on their own. I'm looking for roles in data
            analysis, IT support, automation and embedded or systems work, and I'm happy to start close to the
            ground and learn fast.
          </p>
          <p class="certs">
            <span class="pill pill-grape">Azure Fundamentals (AZ-900)</span>
            <span class="pill">Azure Developer (AZ-204), in progress</span>
          </p>
        </div>
      </section>

      <section id="career" class="section" aria-labelledby="career-title">
        <h2 id="career-title" class="section-title">Career path</h2>
        <ol class="timeline" role="list">
          {
            career.map((c) => (
              <li class={`step c-${c.colour}`}>
                <span class="step-dot" aria-hidden="true" />
                <p class="step-when">{c.when}</p>
                <div class="step-card">
                  <h3 class="step-role">
                    {c.role} <span class="step-org">· {c.org}</span>
                  </h3>
                  <p class="step-place">{c.place}</p>
                  <ul class="step-points" role="list">
                    {c.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                  {c.tags.length > 0 && (
                    <p class="card-tags">
                      {c.tags.map((t) => (
                        <span class="pill">{t}</span>
                      ))}
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <footer class="foot">
        <p>
          Built by me with Astro. Want the details?{' '}
          <a href="/alt/projects/portfolio-site/">See how this site works</a>.
        </p>
      </footer>
    </main>
  </div>
</AltLayout>

<script>
  // Highlight the section in view in the left menu.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]),
  );
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a, id) => a.classList.toggle('is-active', id === e.target.id));
      }
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );
  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  });
</script>

<style>
  .page {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 56px);
  }

  /* ---------- Left: fixed identity ---------- */
  .side {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(40px, 8vh, 88px) 0 clamp(28px, 5vh, 48px);
  }
  .hello {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .wave {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 4px var(--teal-soft);
    animation: pulse 2.8s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 8px var(--teal-soft);
    }
  }
  .headline {
    margin-top: 16px;
    font-size: clamp(2.6rem, 4.8vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .pitch {
    margin-top: 20px;
    max-width: 26rem;
    font-size: 18px;
    color: var(--ink-2);
  }
  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .toc ul {
    list-style: none;
    margin: clamp(28px, 6vh, 56px) 0 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .toc a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 6px 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.2s;
  }
  .toc-bar {
    width: 28px;
    height: 3px;
    border-radius: 2px;
    background: currentColor;
    transition: width 0.4s var(--spring), background-color 0.2s;
  }
  .toc a:hover,
  .toc a.is-active {
    color: var(--ink);
  }
  .toc a:hover .toc-bar,
  .toc a.is-active .toc-bar {
    width: 56px;
    background: var(--tangerine);
  }
  .side-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .socials {
    display: flex;
    gap: 4px;
  }
  .social {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition: transform 0.35s var(--spring), color 0.2s, background-color 0.2s;
  }
  .social:hover {
    color: var(--grape-ink);
    background: var(--grape-soft);
    transform: translateY(-3px) rotate(-6deg);
  }
  .social :global(.icon) {
    width: 20px;
    height: 20px;
  }
  .social :global(.moon) {
    display: none;
  }
  :global(:root[data-theme='dark']) .social :global(.sun) {
    display: none;
  }
  :global(:root[data-theme='dark']) .social :global(.moon) {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .social :global(.sun) {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .social :global(.moon) {
      display: block;
    }
  }

  /* ---------- Right: scrolling content ---------- */
  .content {
    padding: clamp(40px, 8vh, 88px) 0 64px;
    min-width: 0;
  }
  .section {
    padding-top: clamp(64px, 10vh, 104px);
    scroll-margin-top: 24px;
  }
  .section-title {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    margin-bottom: 20px;
  }

  /* Project cards: lift and tint on hover. */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .card {
    --c: var(--grape);
    --c-soft: var(--grape-soft);
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    gap: 16px;
    padding: 20px 22px;
    border-radius: 20px;
    color: inherit;
    text-decoration: none;
    transition: transform 0.4s var(--spring), background-color 0.25s, box-shadow 0.25s;
  }
  .c-teal {
    --c: var(--teal);
    --c-soft: var(--teal-soft);
  }
  .c-tangerine {
    --c: var(--tangerine);
    --c-soft: var(--tangerine-soft);
  }
  .c-sun {
    --c: var(--sun);
    --c-soft: var(--sun-soft);
  }
  .card:hover {
    background: var(--surface);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }
  .card.is-link:hover .card-title {
    color: var(--grape-ink);
  }
  .card-dot {
    width: 14px;
    height: 14px;
    margin-top: 8px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 5px var(--c-soft);
    transition: transform 0.4s var(--spring);
  }
  .card:hover .card-dot {
    transform: scale(1.25);
  }
  .card-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.3rem;
    transition: color 0.2s;
  }
  .card-title :global(.card-arrow) {
    width: 18px;
    height: 18px;
    transition: transform 0.35s var(--spring);
  }
  .card:hover .card-title :global(.card-arrow) {
    transform: translate(4px, -2px) rotate(-12deg);
  }
  .card-automates {
    margin-top: 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-3);
  }
  .card-sum {
    margin-top: 8px;
    color: var(--ink-2);
  }
  .card-result {
    margin-top: 8px;
    font-weight: 700;
    color: var(--teal-ink);
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
  }
  .card-status {
    margin-left: auto;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-3);
  }
  .card-status.live {
    color: var(--grape-ink);
  }

  /* About */
  .about {
    display: grid;
    gap: 16px;
    max-width: 40rem;
    font-size: 18px;
    color: var(--ink-2);
  }
  .certs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Career path: a timeline with coloured stops. */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 28px;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 8px;
    bottom: 8px;
    width: 3px;
    border-radius: 2px;
    background: var(--line);
  }
  .step {
    --c: var(--grape);
    --c-soft: var(--grape-soft);
    position: relative;
    padding-bottom: 28px;
  }
  .step-dot {
    position: absolute;
    left: -28px;
    top: 4px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 4px var(--ground), 0 0 0 7px var(--c-soft);
  }
  .step-when {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .step-card {
    margin-top: 8px;
    padding: 18px 20px;
    border-radius: 18px;
    background: var(--surface);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--line);
    transition: transform 0.4s var(--spring), box-shadow 0.25s;
  }
  .step-card:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-md), inset 0 0 0 1px var(--line);
  }
  .step-role {
    font-size: 1.2rem;
  }
  .step-org {
    color: var(--ink-3);
    font-weight: 600;
  }
  .step-place {
    font-size: 14px;
    color: var(--ink-3);
  }
  .step-points {
    margin: 10px 0 0;
    padding-left: 1.1rem;
    color: var(--ink-2);
    display: grid;
    gap: 6px;
  }
  .step-points li::marker {
    color: var(--c);
  }

  .foot {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 15px;
    color: var(--ink-3);
  }
  .foot a {
    color: var(--grape-ink);
    font-weight: 600;
  }

  @media (max-width: 1000px) {
    .page {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .side {
      position: static;
      height: auto;
      padding-bottom: 8px;
      gap: 28px;
    }
    .toc {
      display: none;
    }
    .content {
      padding-top: 32px;
    }
  }
  @media (max-width: 520px) {
    .card {
      padding: 16px 4px;
      gap: 12px;
    }
    .card-status {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
