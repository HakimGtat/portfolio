---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import AltLayout from '../../alt/AltLayout.astro';
import Icon from '../../alt/Icon.astro';
import Demo from '../../components/Demo.astro';
import ProjectExplorer from '../../components/explorer/ProjectExplorer.tsx';
import { loadProjectView } from '../../lib/project';
import { sourceUrl, SELF_REPO, WORKING_TREE } from '../../lib/source';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => import.meta.env.DEV || p.data.status === 'live');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const view = await loadProjectView(project);
const repoUrl = sourceUrl(data.repo, data.commit);
const version = data.commit === WORKING_TREE ? 'working tree' : data.commit.slice(0, 7);
---

<AltLayout title={data.title} description={data.summary}>
  <div class="bar">
    <a class="back" href="/#projects"><Icon name="arrow-left" class="back-icon" /> Back to {site.shortName}</a>
    <button type="button" class="theme" aria-label="Switch light or dark theme" data-theme-toggle>
      <Icon name="sun" class="sun" />
      <Icon name="moon" class="moon" />
    </button>
  </div>

  <main id="main" class="project">
    <header class="head">
      <p class="kick-pills">
        {data.stack.slice(0, 4).map((t) => <span class="pill">{t}</span>)}
      </p>
      <h1 class="title">{data.title}</h1>
      <p class="summary">{data.summary}</p>
    </header>

    <dl class="facts">
      <div class="fact f-grape">
        <dt>My role</dt>
        <dd>{data.role}</dd>
      </div>
      {
        data.results.length > 0 && (
          <div class="fact f-teal">
            <dt>Result</dt>
            <dd>{data.results.join('; ')}</dd>
          </div>
        )
      }
      <div class="fact f-sun">
        <dt>Source</dt>
        <dd>
          {data.repo === SELF_REPO ? <a href={site.github}>This site's repo</a> : <a href={repoUrl}>{data.repo}</a>}
          <span class="commit" translate="no">{version}</span>
        </dd>
      </div>
    </dl>

    {data.demo && <Demo {...data.demo} />}

    <div class="body">
      <div class="prose">
        <Content />
      </div>
      {
        view.overviewHtml && (
          <aside class="overview" aria-labelledby="overview-title">
            <h2 id="overview-title" class="ov-title">How it works, in plain English</h2>
            <div class="ov-body" set:html={view.overviewHtml} />
          </aside>
        )
      }
    </div>

    <section class="code" aria-labelledby="code-title">
      <details class="drawer">
        <summary>
          <span>
            <h2 id="code-title" class="drawer-title">Curious about the code?</h2>
            <span class="drawer-note">
              Open {view.files.length} key files{view.steps.length > 0 && ` with a ${view.steps.length}-step walkthrough`}.
            </span>
          </span>
          <span class="drawer-btn" aria-hidden="true"><Icon name="arrow-right" /></span>
        </summary>
        <div class="drawer-body">
          <ProjectExplorer client:idle files={view.files} steps={view.steps} repoUrl={repoUrl} />
          {
            !view.reviewed && view.steps.length > 0 && (
              <p class="draft">Dev only: this walkthrough is an unreviewed draft.</p>
            )
          }
        </div>
      </details>
    </section>

    <footer class="foot">
      <p>Like what you see?</p>
      <a class="btn btn-primary" href={`mailto:${site.email}`}>Say hello <Icon name="arrow-right" class="icon-nudge" /></a>
    </footer>
  </main>
</AltLayout>

<style>
  .bar,
  .project {
    position: relative;
    z-index: 1;
    max-width: 1040px;
    margin: 0 auto;
    padding-left: clamp(16px, 4vw, 40px);
    padding-right: clamp(16px, 4vw, 40px);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px 8px 10px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .back:hover {
    background: var(--tint);
  }
  .back :global(.back-icon) {
    transition: transform 0.35s var(--spring);
  }
  .back:hover :global(.back-icon) {
    transform: translateX(-4px);
  }
  .theme {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition: transform 0.35s var(--spring), background-color 0.2s;
  }
  .theme:hover {
    background: var(--grape-soft);
    transform: rotate(-12deg);
  }
  .theme :global(.icon) {
    width: 20px;
    height: 20px;
  }
  .theme :global(.moon) {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme :global(.sun) {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme :global(.moon) {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme :global(.sun) {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .theme :global(.moon) {
      display: block;
    }
  }
  .head {
    padding: clamp(40px, 7vw, 80px) 0 32px;
    max-width: 46rem;
  }
  .kick-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .title {
    margin-top: 18px;
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .summary {
    margin-top: 18px;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    color: var(--ink-2);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
    margin: 0 0 56px;
  }
  .fact {
    padding: 18px 20px;
    border-radius: 18px;
  }
  .f-grape {
    background: var(--grape-soft);
  }
  .f-teal {
    background: var(--teal-soft);
  }
  .f-sun {
    background: var(--sun-soft);
  }
  dt {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-3);
    margin-bottom: 4px;
  }
  dd {
    margin: 0;
    font-weight: 600;
  }
  .commit {
    display: block;
    margin-top: 2px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 400;
    color: var(--ink-3);
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .prose {
    color: var(--ink-2);
    font-size: 17px;
  }
  .prose :global(h2) {
    color: var(--ink);
    font-size: 1.6rem;
    margin: 44px 0 12px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 14px;
  }
  .prose :global(ul) {
    padding-left: 1.2rem;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(li::marker) {
    color: var(--tangerine);
  }
  .prose :global(strong) {
    color: var(--ink);
  }
  .overview {
    position: sticky;
    top: 24px;
    padding: 24px;
    border-radius: 22px;
    background: var(--surface);
    box-shadow: var(--shadow-md), inset 0 0 0 1px var(--line);
  }
  .ov-title {
    font-size: 1.2rem;
    margin-bottom: 10px;
  }
  .ov-body {
    font-size: 15.5px;
    color: var(--ink-2);
  }
  .ov-body :global(p + p) {
    margin-top: 10px;
  }
  .code {
    margin-top: clamp(56px, 8vw, 88px);
  }
  .drawer {
    border-radius: 24px;
    background: var(--tint);
  }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 22px 24px;
    cursor: pointer;
    border-radius: 24px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .drawer-title {
    font-size: 1.5rem;
  }
  .drawer-note {
    display: block;
    margin-top: 2px;
    color: var(--ink-3);
    font-size: 15px;
  }
  .drawer-btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--ink);
    color: var(--ground);
    transition: transform 0.4s var(--spring);
  }
  .drawer-btn :global(.icon) {
    width: 20px;
    height: 20px;
  }
  summary:hover .drawer-btn {
    transform: scale(1.08);
  }
  .drawer[open] .drawer-btn {
    transform: rotate(90deg);
  }
  .drawer-body {
    padding: 0 12px 16px;
  }
  .draft {
    margin: 12px 12px 0;
    font-size: 13px;
    color: var(--tangerine-ink);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 64px;
    padding: 28px 0 56px;
    border-top: 1px solid var(--line);
    font-size: 1.2rem;
    font-weight: 700;
    font-family: var(--display);
  }
  @media (max-width: 860px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    .overview {
      position: static;
    }
  }
</style>
