---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import AltLayout from '../alt/AltLayout.astro';
import Machine from '../alt/Machine.astro';
import Icon from '../alt/Icon.astro';
import CopyEmail from '../alt/CopyEmail.astro';
import { site } from '../data/site';

const live = (
  await getCollection('projects', (p) => import.meta.env.DEV || p.data.status === 'live')
).sort((a, b) => a.data.order - b.data.order);

type Colour = 'grape' | 'teal' | 'tangerine' | 'sun';

// Resume projects still being written up. Facts only, from the resume; tags in plain words.
const upcoming = [
  {
    id: 'proj-prefetch',
    title: 'Markov prefetcher',
    result: '−30% average memory access time',
    summary: 'Predicts the next memory address a program needs and loads it into cache before it is asked for.',
    tags: ['C++', 'Linux', 'CPU simulator'],
    colour: 'teal' as Colour,
  },
  {
    id: 'proj-breezy',
    title: 'Breezy smart fan',
    result: 'Tracks people at 25 FPS',
    summary: 'A fan that finds people with an on-device vision model and aims itself at them. I built the motor control.',
    tags: ['Python', 'Raspberry Pi', 'Computer vision'],
    colour: 'sun' as Colour,
  },
  {
    id: 'proj-lidar',
    title: 'LiDAR room scanner',
    result: 'Full 360° room scans',
    summary: 'A microcontroller turns a distance sensor all the way round and maps the room from the readings.',
    tags: ['Embedded C', 'Microcontroller', 'Python plots'],
    colour: 'tangerine' as Colour,
  },
  {
    id: 'proj-network',
    title: 'Network servers',
    result: 'TCP and UDP, IPv4 and IPv6',
    summary: 'Client and server programs that move data between machines over both kinds of connection.',
    tags: ['Python', 'Networking', 'Sockets'],
    colour: 'teal' as Colour,
  },
  {
    id: 'proj-image',
    title: 'Image decompressor',
    result: 'Built in hardware',
    summary: 'A chip design that rebuilds a compressed image step by step, written as a set of state machines.',
    tags: ['SystemVerilog', 'Digital hardware'],
    colour: 'grape' as Colour,
  },
];

const career = [
  {
    id: 'career-pepsi',
    when: '2025 – 2026',
    role: 'Warehouse Supervisor',
    org: 'Pepsi',
    place: 'Ottawa',
    colour: 'tangerine' as Colour,
    points: [
      'Helped roll out SAP and Microsoft Azure at my site, cutting processing time for orders, deliveries and invoicing by 40%.',
      'Built Excel and Power BI dashboards for productivity, breakage and on-time shipping that management reported from.',
      'Supervised about 100 people and ran the daily scrum to keep weekly shipping quotas on track.',
    ],
    tags: ['SAP', 'Azure', 'Power BI', 'Excel'],
  },
  {
    id: 'career-mcmaster',
    when: 'Dec 2024',
    role: 'B.Eng. Computer Engineering',
    org: 'McMaster University',
    place: 'Hamilton',
    colour: 'grape' as Colour,
    edu: true,
    points: ['Embedded systems, computer architecture, networking and hardware design projects.'],
    tags: ['C', 'C++', 'Python', 'SystemVerilog'],
  },
  {
    id: 'career-thermo',
    when: '2022 – 2023',
    role: 'Reliability Engineer Intern',
    org: 'Thermo Fisher Scientific',
    place: 'Mississauga',
    colour: 'teal' as Colour,
    points: [
      'Automated recurring data pulls with Python and showed the failure patterns to management, which led to schedule changes that cut unplanned downtime by 20%.',
      'Wrote SQL against the IBM Maximo asset database and built a Power BI pipeline that made company-wide KPI reporting 80% faster.',
      'Led root cause investigations on equipment failures at a GMP-regulated plant.',
    ],
    tags: ['Python', 'SQL', 'Power BI', 'IBM Maximo'],
  },
  {
    id: 'career-pryor',
    when: '2022',
    role: 'CNC Machine Operator',
    org: 'Pryor Metals',
    place: 'Ottawa',
    colour: 'sun' as Colour,
    points: ['Read engineering drawings and GD&T tolerances to keep a CNC turret punch press in spec.'],
    tags: [],
  },
];

const hasResume = existsSync(join(process.cwd(), 'public', site.resumePath));
const nav = [
  { id: 'projects', label: 'Projects' },
  { id: 'about', label: 'About' },
  { id: 'career', label: 'Career path' },
  { id: 'contact', label: 'Contact' },
];
---

<AltLayout>
  <div class="page">
    <header class="side">
      <div class="side-top">
        <p class="status"><span class="dot" aria-hidden="true"></span> Open to work · {site.location.replace(', ON', '')}</p>
        <h1 class="name">{site.name}</h1>
        <p class="role">Computer engineer</p>
        <p class="headline">I automate the boring parts.</p>
        <p class="pitch">
          I build tools that clean up data, sort out tasks and run hardware, so people can spend their time on the
          interesting work.
        </p>
        <p class="looking">
          <span class="looking-label">Looking for</span>
          Data analysis · IT support · Automation · Embedded &amp; systems roles
        </p>

        <nav class="toc" aria-label="Sections">
          <ul role="list">
            {
              nav.map((n) => (
                <li>
                  <a href={`#${n.id}`} data-toc={n.id}>
                    <span class="toc-bar" aria-hidden="true" />
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="side-bottom">
        <div class="side-actions">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>
            Say hello <Icon name="arrow-right" class="icon-nudge" />
          </a>
          <div class="socials">
            <a class="social" href={site.github} aria-label="GitHub"><Icon name="github" /></a>
            <a class="social" href={site.linkedin} aria-label="LinkedIn"><Icon name="linkedin" /></a>
            {hasResume && <a class="social" href={site.resumePath} download aria-label="Download resume"><Icon name="download" /></a>}
            <button type="button" class="social" data-theme-toggle aria-label="Switch to dark theme">
              <Icon name="sun" class="sun" />
              <Icon name="moon" class="moon" />
            </button>
          </div>
        </div>
        <CopyEmail />
      </div>
    </header>

    <main id="main" class="content">
      <Machine />

      <section id="projects" class="section" aria-labelledby="projects-title">
        <h2 id="projects-title" class="section-title">Projects</h2>

        <ul class="featured" role="list">
          {
            live.map((p) => (
              <li>
                <a class="feature" href={`/projects/${p.id}/`} aria-label={`Read the write-up: ${p.data.title}`}>
                  <span class="feature-badge pill pill-grape">Full write-up and code</span>
                  <h3 class="feature-title">{p.data.title}</h3>
                  <p class="feature-sum">{p.data.summary}</p>
                  <p class="feature-meta">
                    {p.data.stack.slice(0, 4).map((t) => (
                      <span class="pill">{t}</span>
                    ))}
                  </p>
                  <span class="feature-cta">
                    Read the write-up <Icon name="arrow-right" />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="resume-head">
          <h3 class="resume-title">From my resume</h3>
          <p class="resume-note">Write-ups with code are on the way.</p>
        </div>
        <ul class="resume-list" role="list">
          {
            upcoming.map((p) => (
              <li id={p.id} class={`rp c-${p.colour}`}>
                <span class="rp-dot" aria-hidden="true" />
                <div>
                  <p class="rp-top">
                    <span class="rp-title">{p.title}</span>
                    <span class="rp-result">{p.result}</span>
                  </p>
                  <p class="rp-sum">{p.summary}</p>
                  <p class="rp-tags">{p.tags.join(' · ')}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="about" class="section" aria-labelledby="about-title">
        <h2 id="about-title" class="section-title">About</h2>
        <div class="about">
          <p>
            I studied computer engineering at McMaster, and I've worked on a plant floor, in a warehouse and in
            code. The common thread is that I can't leave a repetitive job alone: if something is done by hand
            every week, I want to script it, dashboard it or build a machine for it.
          </p>
          <p>
            That's taken me from Python scripts that pull maintenance data, to Power BI reports managers
            actually use, to microcontrollers that measure a room on their own. I'm looking for roles in data
            analysis, IT support, automation and embedded or systems work, and I'm happy to start close to the
            ground and learn fast.
          </p>
          <p class="certs">
            <span class="pill pill-grape">Azure Fundamentals (AZ-900)</span>
            <span class="pill">Azure Developer (AZ-204), in progress</span>
          </p>
        </div>
      </section>

      <section id="career" class="section" aria-labelledby="career-title">
        <h2 id="career-title" class="section-title">Career path</h2>
        <ol class="timeline" role="list">
          {
            career.map((c) => (
              <li id={c.id} class:list={['step', `c-${c.colour}`, { 'is-edu': c.edu }]}>
                <span class="step-dot" aria-hidden="true" />
                <p class="step-when">
                  {c.when}
                  {c.edu && <span class="step-kind"> · Education</span>}
                </p>
                <div class="step-card">
                  <h3 class="step-role">
                    {c.role} <span class="step-org">· {c.org}</span>
                  </h3>
                  <p class="step-place">{c.place}</p>
                  <ul class="step-points" role="list">
                    {c.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                  {c.tags.length > 0 && (
                    <p class="step-tags">
                      {c.tags.map((t) => (
                        <span class="pill">{t}</span>
                      ))}
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="contact" class="section contact" aria-labelledby="contact-title">
        <h2 id="contact-title" class="contact-title">Hiring for data, IT or automation?</h2>
        <p class="contact-text">
          I'd love to hear about it. Email is the fastest way to reach me, and I usually reply within a day.
        </p>
        <div class="contact-actions">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>
            Say hello <Icon name="arrow-right" class="icon-nudge" />
          </a>
          <CopyEmail large />
        </div>
        <p class="contact-links">
          <a href={site.linkedin}>LinkedIn</a>
          <a href={site.github}>GitHub</a>
          {hasResume && <a href={site.resumePath} download>Resume (PDF)</a>}
        </p>
      </section>

      <footer class="foot">
        <p>
          Built by me with Astro. Curious how?{' '}
          <a href="/projects/portfolio-site/">See how this site works</a>.
        </p>
      </footer>
    </main>
  </div>

  <nav class="mobile-bar" aria-label="Quick links">
    <a href="#projects">Projects</a>
    <a href="#career">Career</a>
    <a class="mobile-cta" href="#contact">Contact</a>
  </nav>
</AltLayout>

<script>
  // Highlight the section in view in the left menu.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]),
  );
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a, id) => {
          const on = id === e.target.id;
          a.classList.toggle('is-active', on);
          if (on) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      }
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );
  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  });
</script>

<style>
  .page {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 56px);
  }

  /* ---------- Left: fixed identity ---------- */
  .side {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(36px, 7vh, 80px) 0 clamp(24px, 4vh, 40px);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--teal-ink);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 4px var(--teal-soft);
  }
  .name {
    margin-top: 18px;
    font-family: var(--display);
    letter-spacing: -0.02em;
    font-size: clamp(1.5rem, 2.2vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .role {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .headline {
    margin-top: 18px;
    font-family: var(--display);
    font-size: clamp(2.4rem, 4.2vw, 3.9rem);
    font-weight: 800;
    text-wrap: balance;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .pitch {
    margin-top: 18px;
    max-width: 26rem;
    font-size: 17.5px;
    color: var(--ink-2);
  }
  .looking {
    margin-top: 16px;
    max-width: 26rem;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }
  .looking-label {
    display: block;
    font-size: 13px;
    color: var(--ink-2);
    font-weight: 600;
    margin-bottom: 2px;
  }
  .toc ul {
    list-style: none;
    margin: clamp(20px, 4.5vh, 44px) 0 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .toc a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 5px 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.2s;
  }
  .toc-bar {
    width: 28px;
    height: 3px;
    border-radius: 2px;
    background: currentColor;
    transition: width 0.4s var(--spring), background-color 0.2s;
  }
  .toc a:hover,
  .toc a.is-active {
    color: var(--ink);
  }
  .toc a:hover .toc-bar,
  .toc a.is-active .toc-bar {
    width: 56px;
    background: var(--tangerine);
  }
  .side-bottom {
    display: grid;
    gap: 12px;
  }
  .side-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .socials {
    display: flex;
    gap: 2px;
  }
  .social {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition: transform 0.35s var(--spring), color 0.2s, background-color 0.2s;
  }
  .social:hover {
    color: var(--grape-ink);
    background: var(--grape-soft);
    transform: translateY(-3px) rotate(-6deg);
  }
  .social :global(.icon) {
    width: 20px;
    height: 20px;
  }
  .social :global(.moon) {
    display: none;
  }
  :global(:root[data-theme='dark']) .social :global(.sun) {
    display: none;
  }
  :global(:root[data-theme='dark']) .social :global(.moon) {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .social :global(.sun) {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .social :global(.moon) {
      display: block;
    }
  }

  /* ---------- Right: scrolling content ---------- */
  .content {
    padding: clamp(36px, 7vh, 80px) 0 64px;
    min-width: 0;
  }
  .section {
    padding-top: clamp(64px, 10vh, 104px);
    scroll-margin-top: 24px;
  }
  .section-title {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    margin-bottom: 20px;
  }

  /* Featured write-up: the one card that opens, so the only one that lifts. */
  .featured {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .feature {
    display: grid;
    gap: 10px;
    padding: 26px 28px;
    border-radius: 24px;
    background: var(--surface);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--line);
    color: inherit;
    text-decoration: none;
    transition: transform 0.4s var(--spring), box-shadow 0.25s;
  }
  .feature:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md), inset 0 0 0 2px var(--grape);
  }
  .feature-badge {
    justify-self: start;
  }
  .feature-title {
    font-size: 1.6rem;
    font-weight: 800;
    transition: color 0.2s;
  }
  .feature:hover .feature-title {
    color: var(--grape-ink);
  }
  .feature-sum {
    color: var(--ink-2);
    max-width: 36rem;
  }
  .feature-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .feature-cta {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    padding: 9px 16px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--ground);
    font-weight: 700;
    font-size: 15px;
  }
  .feature-cta :global(.icon) {
    transition: transform 0.35s var(--spring);
  }
  .feature:hover .feature-cta :global(.icon) {
    transform: translateX(4px);
  }

  /* Resume projects: a compact, static list led by each result. */
  .resume-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    margin: 36px 0 6px;
  }
  .resume-title {
    font-size: 1.2rem;
  }
  .resume-note {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .resume-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rp {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    gap: 14px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 80px;
  }
  .rp:target {
    background: var(--sun-soft);
    border-radius: 14px;
    padding-left: 10px;
    padding-right: 10px;
  }
  .rp-dot {
    width: 12px;
    height: 12px;
    margin-top: 7px;
    border-radius: 50%;
    background: var(--c, var(--grape));
  }
  .rp.c-teal {
    --c: var(--teal);
  }
  .rp.c-tangerine {
    --c: var(--tangerine);
  }
  .rp.c-sun {
    --c: var(--sun);
  }
  .rp.c-grape {
    --c: var(--grape);
  }
  .rp-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
  }
  .rp-title {
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .rp-result {
    font-size: 14.5px;
    font-weight: 700;
    color: var(--teal-ink);
  }
  .rp-sum {
    margin-top: 2px;
    color: var(--ink-2);
    font-size: 16px;
  }
  .rp-tags {
    margin-top: 4px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink-2);
  }

  /* About */
  .about {
    display: grid;
    gap: 16px;
    max-width: 40rem;
    font-size: 18px;
    color: var(--ink-2);
  }
  .certs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Career path: a timeline with coloured stops; education gets a square stop. */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 28px;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 8px;
    bottom: 8px;
    width: 3px;
    border-radius: 2px;
    background: var(--line);
  }
  .step {
    position: relative;
    padding-bottom: 28px;
    scroll-margin-top: 24px;
  }
  .step.c-teal {
    --c: var(--teal);
    --c-soft: var(--teal-soft);
  }
  .step.c-tangerine {
    --c: var(--tangerine);
    --c-soft: var(--tangerine-soft);
  }
  .step.c-sun {
    --c: var(--sun);
    --c-soft: var(--sun-soft);
  }
  .step.c-grape {
    --c: var(--grape);
    --c-soft: var(--grape-soft);
  }
  .step-dot {
    position: absolute;
    left: -28px;
    top: 4px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 4px var(--ground), 0 0 0 7px var(--c-soft);
  }
  .is-edu .step-dot {
    border-radius: 4px;
    transform: rotate(45deg);
  }
  .step-when {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .step-kind {
    color: var(--grape-ink);
  }
  .step-card {
    margin-top: 8px;
    padding: 18px 20px;
    border-radius: 18px;
    background: var(--surface);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--line);
  }
  .step:target .step-card {
    box-shadow: var(--shadow-md), inset 0 0 0 2px var(--c);
  }
  .step-role {
    font-size: 1.2rem;
  }
  .step-org {
    color: var(--ink-2);
    font-weight: 600;
  }
  .step-place {
    font-size: 14px;
    color: var(--ink-2);
  }
  .step-points {
    margin: 10px 0 0;
    padding-left: 1.1rem;
    color: var(--ink-2);
    display: grid;
    gap: 6px;
  }
  .step-points li::marker {
    color: var(--c);
  }
  .step-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  /* Closing contact block */
  .contact {
    margin-top: 24px;
    padding: clamp(28px, 4vw, 44px);
